ENV=development
DATABASE_URL=postgresql+asyncpg://appshop:appshop@localhost:5432/appshop
MIGRATION_DATABASE_URL=postgresql+psycopg://appshop:appshop@localhost:5432/appshop
# For integration tests, point both URLs at the isolated appshop_test database.
# DATABASE_URL=postgresql+asyncpg://appshop:appshop@localhost:5432/appshop_test
# MIGRATION_DATABASE_URL=postgresql+psycopg://appshop:appshop@localhost:5432/appshop_test
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
JWT_SECRET=development-only-change-this-jwt-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
HOUSEHOLD_INVITE_TTL_DAYS=7
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage
JWT_SECRET=development-only-change-this-jwt-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
