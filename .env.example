# Shared/local development
ENV=development

# Backend
DATABASE_URL=postgresql+asyncpg://appshop:appshop@localhost:5432/appshop
MIGRATION_DATABASE_URL=postgresql+psycopg://appshop:appshop@localhost:5432/appshop
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
JWT_SECRET=development-only-change-this-jwt-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
HOUSEHOLD_INVITE_TTL_DAYS=7
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage
JWT_SECRET=development-only-change-this-jwt-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Mobile (for a physical device, replace localhost with the computer LAN IP)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
