{
  "expo": {
    "name": "AppShop",
    "slug": "household-shopping",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "householdshopping",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AppShop to choose a product photo from your library.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.example.householdshopping"
    },
    "ios": {
      "bundleIdentifier": "com.example.householdshopping"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6814b859-765a-4096-82df-630e70473699"
      }
    },
    "owner": "collinsrono"
  }
}
